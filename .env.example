# ---------------------------------------------------------------------------
# tg-vitrina — single-shop Telegram Mini App
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Store configuration (this deployment IS one store) --------------------
STORE_NAME="My Shop"
STORE_DESCRIPTION="Example storefront description"
STORE_LOGO=/media/store/logo.png
STORE_CONTACT_TG=my_shop_support

# --- Telegram channel this store's catalog is sourced from -----------------
# Numeric id of the channel (e.g. -1001234567890)
TELEGRAM_CHANNEL_ID=

# --- Bot (aiogram) ----------------------------------------------------------
BOT_TOKEN=

# --- Userbot (Pyrogram) — used only for one-time/periodic history backfill -
USERBOT_API_ID=
USERBOT_API_HASH=
# Pyrogram session string (generate locally, never commit it)
USERBOT_SESSION=
USERBOT_IPV6=false
# How often (seconds) the userbot polls the backend for a requested sync job
USERBOT_POLL_INTERVAL=10
# How many Telegram messages the userbot fetches/ingests per batch
USERBOT_BATCH_SIZE=10
# Backend internal API base URL, reachable from the userbot container/process
BACKEND_INTERNAL_URL=http://backend:8000/api/v1/internal/sync

# --- Extractor (OpenRouter / OpenAI-compatible) -----------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# How often (seconds) the extractor worker checks for new raw posts
EXTRACTOR_POLL_INTERVAL=15

# --- Database ----------------------------------------------------------------
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_USER=vitrina
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vitrina

# --- Auth / security ---------------------------------------------------------
# Secret used to sign session JWTs issued after Telegram initData validation
JWT_SECRET=change_me_please
JWT_EXPIRE_MINUTES=43200
# Comma-separated Telegram user ids that are always treated as admins
SUPER_ADMIN_IDS=
# Shared secret the userbot uses to call the backend's internal sync API
INTERNAL_API_TOKEN=change_me_internal_token

# --- Media storage ------------------------------------------------------------
MEDIA_ROOT=/media

# --- Misc ----------------------------------------------------------------------
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173
DOMAIN=localhost
# Public HTTPS URL of the Mini App (usually https://$DOMAIN). Used by the
# bot's /start reply to show an "Open shop" WebApp button. Leave empty to
# have /start just send a greeting with no button.
WEBAPP_URL=
# Short name of the Mini App's Direct Link from @BotFather ("Bot Settings →
# Mini App → Direct Links → Create Direct Link"). Required for
# https://t.me/<bot>/<name>?startapp=... deep links (share links, invite
# links, "Открыть в витрине" channel buttons) to actually launch the Mini
# App instead of just opening the bot's chat.
MINI_APP_SHORT_NAME=menu
